{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch with tsx watch (express-app)",
      "cwd": "${workspaceFolder}/express-app",
      "runtimeExecutable": "${workspaceFolder}/express-app/node_modules/.bin/tsx",
      "args": ["watch", "src/main.ts"],
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
